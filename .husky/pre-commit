#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

cd frontend
echo "Running lint-staged..."
npx lint-staged || exit 1

echo "Running frontend tests..."
npm run test:ci || exit 1

cd ../azfunctions
echo "Setting up Python virtual environment..."
if [ ! -d ".venv" ]; then
    python -m venv .venv
    . .venv/Scripts/activate
    pip install -r requirements.txt
else
    . .venv/Scripts/activate
fi

echo "Running Azure Functions tests..."
# Run tests and exit on failure
python -m pytest tests/ -v || exit 1

echo "Running uat tests..."
# Run UAT tests including those marked with external_services
python -m pytest uat/ -v -m "external_services" || exit 1
